{
  "name": "seo-prompt-master",
  "version": "2.1.0",
  "description": "Open-source technical SEO and GEO (AI search) audit: a zero-dependency CLI, an AI agent skill, 47 SEO prompts and a cited knowledge base of Google, Bing and AI-crawler rules.",
  "type": "module",
  "bin": {
    "seo-audit": "tools/seo-audit.mjs",
    "seo-prompt-master": "tools/seo-audit.mjs"
  },
  "scripts": {
    "audit": "node tools/seo-audit.mjs",
    "smoke": "bash tools/seo-smoke.sh",
    "prompts:csv": "node tools/build-prompts-csv.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "tools/",
    "docs/",
    "prompts/",
    "prompt-library/",
    "verticals/",
    "checklists/",
    "templates/",
    "examples/",
    "START.md",
    "VERSION",
    "install.sh"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["seo", "seo-audit", "technical-seo", "seo-checker", "geo", "generative-engine-optimization", "ai-search", "audit", "prompts", "core-web-vitals", "robots.txt", "sitemap", "hreflang", "canonical", "structured-data", "schema-org", "indexnow", "claude-code", "codex", "cursor", "gemini-cli", "copilot"],
  "author": "Umut Bayraktar (https://github.com/umutxyp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutxyp/Seo-Promt-Master.git"
  }
}
